/* Default look of the Visual Novel Teller dialogue box. It styles every control
   itself, so it renders correctly without a theme style sheet. */

.vnt-root {
    flex-grow: 1;
    flex-direction: column;
    justify-content: flex-end;
    padding: 48px 120px;
}

.vnt-choices {
    flex-direction: column;
    align-items: center;
    margin-bottom: 32px;
}

.vnt-choice {
    min-width: 800px;
    max-width: 1500px;
    margin: 8px 0;
    padding: 18px 36px;
    font-size: 38px;
    color: rgb(255, 255, 255);
    background-color: rgb(28, 32, 60);
    border-width: 3px;
    border-color: rgb(235, 235, 255);
    border-radius: 14px;
    -unity-text-align: middle-center;
    white-space: normal;
}

.vnt-choice:hover {
    background-color: rgb(64, 76, 140);
}

.vnt-choice:active {
    background-color: rgb(104, 118, 196);
}

.vnt-choice:focus {
    border-color: rgb(255, 220, 90);
}

.vnt-choice:disabled,
.vnt-choice--disabled {
    color: rgb(140, 140, 150);
    background-color: rgb(40, 40, 48);
    border-color: rgb(90, 90, 100);
}

.vnt-timer {
    width: 800px;
    height: 16px;
    margin-top: 12px;
    background-color: rgb(40, 40, 60);
    border-width: 2px;
    border-color: rgb(235, 235, 255);
    border-radius: 8px;
    overflow: hidden;
}

.vnt-timer-fill {
    height: 100%;
    background-color: rgb(255, 200, 60);
}

.vnt-box {
    min-height: 260px;
    padding: 28px 44px 40px 44px;
    background-color: rgba(10, 12, 28, 0.93);
    border-width: 3px;
    border-color: rgb(235, 235, 255);
    border-radius: 18px;
}

.vnt-speaker {
    margin-bottom: 10px;
    font-size: 46px;
    -unity-font-style: bold;
    color: rgb(255, 255, 255);
}

.vnt-text {
    font-size: 40px;
    color: rgb(255, 255, 255);
    white-space: normal;
    -unity-text-align: upper-left;
}

/* The small triangle that shows when the line is ready to continue. */
.vnt-more {
    position: absolute;
    right: 40px;
    bottom: 24px;
    width: 0;
    height: 0;
    border-top-width: 20px;
    border-left-width: 14px;
    border-right-width: 14px;
    border-top-color: rgb(255, 255, 255);
    border-left-color: rgba(0, 0, 0, 0);
    border-right-color: rgba(0, 0, 0, 0);
}
