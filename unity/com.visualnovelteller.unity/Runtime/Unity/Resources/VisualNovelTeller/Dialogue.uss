/* Default look of the Visual Novel Teller dialogue box. It styles every control
   itself, so it renders correctly without a theme style sheet. */

.vnt-root {
    flex-grow: 1;
    flex-direction: column;
    justify-content: flex-end;
    padding: 48px 120px;
}

.vnt-choices {
    flex-direction: column;
    align-items: center;
    margin-bottom: 64px;
}

.vnt-choice {
    min-width: 900px;
    max-width: 1600px;
    margin: 10px 0;
    padding: 20px 40px;
    font-size: 46px;
    color: rgb(255, 255, 255);
    background-color: rgb(28, 32, 60);
    border-width: 3px;
    border-color: rgb(235, 235, 255);
    border-radius: 14px;
    -unity-text-align: middle-center;
    white-space: normal;
}

.vnt-choice:hover {
    background-color: rgb(64, 76, 140);
}

.vnt-choice:active {
    background-color: rgb(104, 118, 196);
}

.vnt-choice:focus {
    border-color: rgb(255, 220, 90);
}

.vnt-choice:disabled,
.vnt-choice--disabled {
    color: rgb(140, 140, 150);
    background-color: rgb(40, 40, 48);
    border-color: rgb(90, 90, 100);
}

.vnt-timer {
    width: 800px;
    height: 16px;
    margin-top: 12px;
    background-color: rgb(40, 40, 60);
    border-width: 2px;
    border-color: rgb(235, 235, 255);
    border-radius: 8px;
    overflow: hidden;
}

.vnt-timer-fill {
    height: 100%;
    background-color: rgb(255, 200, 60);
}

.vnt-box {
    min-height: 300px;
    padding: 28px 44px 40px 44px;
    background-color: rgba(10, 12, 28, 0.93);
    border-width: 3px;
    border-color: rgb(235, 235, 255);
    border-radius: 18px;
}

.vnt-speaker {
    margin-bottom: 12px;
    font-size: 54px;
    -unity-font-style: bold;
    color: rgb(255, 255, 255);
}

.vnt-text {
    font-size: 50px;
    color: rgb(255, 255, 255);
    white-space: normal;
    -unity-text-align: upper-left;
}

/* The small triangle that shows when the line is ready to continue. */
.vnt-more {
    position: absolute;
    right: 40px;
    bottom: 24px;
    width: 0;
    height: 0;
    border-top-width: 20px;
    border-left-width: 14px;
    border-right-width: 14px;
    border-top-color: rgb(255, 255, 255);
    border-left-color: rgba(0, 0, 0, 0);
    border-right-color: rgba(0, 0, 0, 0);
}

/* The row of small buttons above the top-right corner of the dialogue box. */
.vnt-quick {
    position: absolute;
    right: 24px;
    top: -56px;
    flex-direction: row;
}

.vnt-quick-button {
    margin: 0 0 0 8px;
    padding: 4px 18px;
    font-size: 28px;
    color: rgba(255, 255, 255, 0.7);
    background-color: rgba(10, 12, 28, 0.6);
    border-width: 2px;
    border-color: rgba(235, 235, 255, 0.5);
    border-radius: 10px;
}

.vnt-quick-button:hover {
    color: rgb(255, 255, 255);
    background-color: rgba(64, 76, 140, 0.9);
    border-color: rgb(235, 235, 255);
}

.vnt-quick-button.vnt-on {
    color: rgb(255, 220, 90);
    border-color: rgb(255, 220, 90);
}

/* The history screen is built in code and covers the whole panel. */
.vnt-history {
    flex-direction: column;
    padding: 64px 160px;
    background-color: rgba(0, 0, 0, 0.85);
}

.vnt-history-title {
    margin-bottom: 20px;
    font-size: 64px;
    -unity-font-style: bold;
    color: rgb(255, 255, 255);
    -unity-text-align: upper-center;
}

.vnt-history-scroll {
    flex-grow: 1;
    flex-shrink: 1;
    margin-bottom: 24px;
}

.vnt-history-entry {
    margin-bottom: 28px;
}

.vnt-history-speaker {
    font-size: 40px;
    -unity-font-style: bold;
    color: rgb(255, 255, 255);
}

.vnt-history-text {
    font-size: 40px;
    color: rgb(255, 255, 255);
    white-space: normal;
    -unity-text-align: upper-left;
}

.vnt-history-replay {
    align-self: flex-start;
    margin-top: 8px;
    padding: 6px 20px;
    font-size: 30px;
    color: rgb(255, 255, 255);
    background-color: rgb(28, 32, 60);
    border-width: 2px;
    border-color: rgb(180, 185, 220);
    border-radius: 10px;
}

.vnt-history-replay:hover {
    background-color: rgb(48, 54, 96);
}

.vnt-history-close {
    align-self: center;
    min-width: 300px;
    padding: 14px 40px;
    font-size: 40px;
    color: rgb(255, 255, 255);
    background-color: rgb(28, 32, 60);
    border-width: 3px;
    border-color: rgb(235, 235, 255);
    border-radius: 14px;
}

.vnt-history-close:hover {
    background-color: rgb(64, 76, 140);
}
