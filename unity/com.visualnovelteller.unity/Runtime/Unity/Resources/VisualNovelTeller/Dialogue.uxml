<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <ui:VisualElement name="vnt-root" class="vnt-root">
        <ui:VisualElement name="vnt-choices" class="vnt-choices" />
        <ui:VisualElement name="vnt-box" class="vnt-box">
            <ui:Label name="vnt-speaker" class="vnt-speaker" />
            <ui:Label name="vnt-text" class="vnt-text" />
            <ui:VisualElement name="vnt-quick" class="vnt-quick">
                <ui:Button name="vnt-auto" text="Auto" class="vnt-quick-button" />
                <ui:Button name="vnt-skip" text="Skip" class="vnt-quick-button" />
                <ui:Button name="vnt-history" text="History" class="vnt-quick-button" />
                <ui:Button name="vnt-save" text="Save" class="vnt-quick-button" />
                <ui:Button name="vnt-load" text="Load" class="vnt-quick-button" />
            </ui:VisualElement>
            <ui:VisualElement name="vnt-more" class="vnt-more" picking-mode="Ignore" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
