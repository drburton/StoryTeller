<Project Sdk="Microsoft.NET.Sdk">

  <!-- Compile-only stand-ins for the Unity APIs the package uses. They let
       the package be compiled without Unity. They have no behavior. -->
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <RootNamespace>UnityStubs</RootNamespace>
    <AssemblyName>UnityStubs</AssemblyName>
  </PropertyGroup>

</Project>
